[
    {
        "id": "tab-evac",
        "label": "Evacuation Dashboard",
        "disabled": false,
        "info": ""
    },
    {
        "id": "mqtt-in-hazard",
        "type": "mqtt in",
        "z": "tab-evac",
        "name": "Hazard Data",
        "topic": "evac/node/+/hazard",
        "qos": "1",
        "datatype": "auto",
        "broker": "mqtt-broker",
        "x": 120,
        "y": 80,
        "wires": [["function-parse"]]
    },
    {
        "id": "mqtt-in-status",
        "type": "mqtt in",
        "z": "tab-evac",
        "name": "Node Status",
        "topic": "evac/node/+/status",
        "qos": "1",
        "datatype": "auto",
        "broker": "mqtt-broker",
        "x": 120,
        "y": 160,
        "wires": [["function-store-status"]]
    },
    {
        "id": "function-parse",
        "type": "function",
        "z": "tab-evac",
        "name": "Parse Hazard",
        "func": "var msg2 = {};\ntry {\n    var data = JSON.parse(msg.payload);\n    var topicParts = msg.topic.split('/');\n    var nodeId = topicParts[2];\n    \n    msg2.payload = {\n        node_id: data.node_id,\n        temp: data.temp,\n        smoke: data.smoke,\n        flame: data.flame,\n        cost: data.cost,\n        topic: msg.topic\n    };\n    \n    var nodeData = global.get('nodeData') || {};\n    nodeData[nodeId] = msg2.payload;\n    global.set('nodeData', nodeData);\n} catch(e) {\n    node.warn(\"Parse error: \" + e);\n}\nreturn msg2;",
        "outputs": 1,
        "noerr": 0,
        "x": 300,
        "y": 80,
        "wires": [["ui-floor-grid"]]
    },
    {
        "id": "function-store-status",
        "type": "function",
        "z": "tab-evac",
        "name": "Store Status",
        "func": "var topicParts = msg.topic.split('/');\nvar nodeId = topicParts[2];\nvar nodeStatus = global.get('nodeStatus') || {};\nnodeStatus[nodeId] = {\n    status: msg.payload,\n    updated: Date.now()\n};\nglobal.set('nodeStatus', nodeStatus);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 300,
        "y": 160,
        "wires": [["ui-health-panel"]]
    },
    {
        "id": "ui-floor-grid",
        "type": "ui_template",
        "z": "tab-evac",
        "name": "Floor Grid",
        "template": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<style>\n.grid-container { display: flex; flex-direction: column; gap: 20px; padding: 20px; }\n.floor-section { background: #1a1a2e; border-radius: 12px; padding: 16px; }\n.floor-title { color: #e0e0e0; font-size: 16px; margin-bottom: 12px; }\n.node-grid { display: flex; gap: 16px; flex-wrap: wrap; }\n.node-card {\n    background: #16213e;\n    border: 2px solid #0f3460;\n    border-radius: 10px;\n    padding: 12px 16px;\n    min-width: 140px;\n    text-align: center;\n    transition: all 0.3s;\n}\n.node-card.safe { border-color: #00ff88; }\n.node-card.warning { border-color: #ffd700; }\n.node-card.danger { border-color: #ff4444; animation: pulse 1s infinite; }\n.node-card.shelter { border-color: #ffffff; animation: strobe 0.5s infinite; }\n.node-card.exit { background: #1a3a2e; }\n.node-id { color: #fff; font-weight: bold; font-size: 18px; }\n.node-temp { color: #ff6b6b; font-size: 14px; }\n.node-smoke { color: #ffd93d; font-size: 14px; }\n.node-flame { color: #ff4444; font-size: 14px; }\n.node-cost { color: #6bcbff; font-size: 14px; }\n.node-status { color: #aaa; font-size: 12px; margin-top: 4px; }\n.exit-badge {\n    background: #00ff88;\n    color: #000;\n    border-radius: 4px;\n    padding: 2px 6px;\n    font-size: 11px;\n    font-weight: bold;\n}\n@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }\n@keyframes strobe { 0%,100% { background: #fff; color: #000; } 50% { background: #333; color: #fff; } }\n</style>\n<div class=\"grid-container\">\n<div class=\"floor-section\">\n<div class=\"floor-title\"><i class=\"fas fa-building\"></i> Floor 0</div>\n<div class=\"node-grid\" id=\"node-grid-0\">\nLoading...\n</div>\n</div>\n</div>\n<script>\n(function() {\n    function renderGrid(data) {\n        var grid = document.getElementById('node-grid-0');\n        if (!grid) return;\n        var html = '';\n        var nodes = data || {};\n        for (var id in nodes) {\n            var n = nodes[id];\n            var cls = 'node-card';\n            if (n.flame) cls += ' danger';\n            else if (n.cost > 50000) cls += ' shelter';\n            else if (n.cost > 10000) cls += ' warning';\n            else cls += ' safe';\n            if (n.is_exit) cls += ' exit';\n            html += '<div class=\"' + cls + '\">';\n            html += '<div class=\"node-id\">Node ' + id + (n.is_exit ? ' <span class=\"exit-badge\">EXIT</span>' : '') + '</div>';\n            html += '<div class=\"node-temp\"><i class=\"fas fa-temperature-high\"></i> ' + (n.temp || '--') + '°C</div>';\n            html += '<div class=\"node-smoke\"><i class=\"fas fa-smog\"></i> ' + (n.smoke || '0') + ' ppm</div>';\n            if (n.flame) html += '<div class=\"node-flame\"><i class=\"fas fa-fire\"></i> FLAME</div>';\n            html += '<div class=\"node-cost\">Cost: ' + (n.cost ? n.cost.toFixed(0) : '0') + '</div>';\n            html += '</div>';\n        }\n        grid.innerHTML = html || '<div>No node data received</div>';\n    }\n    setInterval(function() {\n        fetch('/evac/api/nodes').then(r => r.json()).then(renderGrid).catch(() => {});\n    }, 1000);\n})();\n</script>",
        "order": 1,
        "width": 12,
        "height": 6,
        "format": "html",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 480,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "ui-health-panel",
        "type": "ui_template",
        "z": "tab-evac",
        "name": "Health Panel",
        "template": "<style>\n.health-table { width: 100%; border-collapse: collapse; margin-top: 8px; }\n.health-table th { color: #888; font-size: 12px; text-align: left; padding: 4px 8px; border-bottom: 1px solid #333; }\n.health-table td { padding: 6px 8px; font-size: 13px; border-bottom: 1px solid #222; }\n.health-ok { color: #00ff88; }\n.health-fault { color: #ff4444; font-weight: bold; }\n</style>\n<h3 style=\"color:#e0e0e0;margin:0 0 8px 0\"><i class=\"fas fa-heartbeat\"></i> Node Health</h3>\n<table class=\"health-table\">\n<thead><tr><th>Node</th><th>Status</th><th>Last Update</th></tr></thead>\n<tbody id=\"health-body\">\n<tr><td colspan=\"3\" style=\"color:#666\">Waiting for data...</td></tr>\n</tbody>\n</table>\n<script>\n(function() {\n    function renderHealth(data) {\n        var tbody = document.getElementById('health-body');\n        if (!tbody) return;\n        var html = '';\n        for (var id in data) {\n            var s = data[id];\n            var cls = (s.status && s.status.indexOf('FAULT') >= 0) ? 'health-fault' : 'health-ok';\n            html += '<tr><td>Node ' + id + '</td><td class=\"' + cls + '\">' + (s.status || 'unknown') + '</td><td>' + new Date(s.updated).toLocaleTimeString() + '</td></tr>';\n        }\n        tbody.innerHTML = html || '<tr><td colspan=\"3\" style=\"color:#666\">No nodes reporting</td></tr>';\n    }\n    setInterval(function() {\n        fetch('/evac/api/health').then(r => r.json()).then(renderHealth).catch(() => {});\n    }, 1000);\n})();\n</script>",
        "order": 2,
        "width": 6,
        "height": 6,
        "format": "html",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 480,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "http-api-nodes",
        "type": "http in",
        "z": "tab-evac",
        "name": "API Nodes",
        "url": "/evac/api/nodes",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 120,
        "y": 280,
        "wires": [["http-rsp-nodes"]]
    },
    {
        "id": "http-rsp-nodes",
        "type": "function",
        "z": "tab-evac",
        "name": "Respond Nodes",
        "func": "var nodeData = global.get('nodeData') || {};\nvar nodeStatus = global.get('nodeStatus') || {};\n\nvar result = {};\nvar graph = global.get('graph') || {};\n\nfor (var id in nodeData) {\n    var n = nodeData[id];\n    result[id] = n;\n    if (graph[id]) {\n        result[id].is_exit = graph[id].is_exit;\n        result[id].floor = graph[id].floor;\n    }\n}\n\nmsg.payload = result;\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Access-Control-Allow-Origin': '*'\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 300,
        "y": 280,
        "wires": [["http-rsp-out"]]
    },
    {
        "id": "http-rsp-out",
        "type": "http response",
        "z": "tab-evac",
        "name": "HTTP Response",
        "statusCode": "200",
        "headers": {},
        "x": 480,
        "y": 280,
        "wires": [[]]
    },
    {
        "id": "http-api-health",
        "type": "http in",
        "z": "tab-evac",
        "name": "API Health",
        "url": "/evac/api/health",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 120,
        "y": 360,
        "wires": [["http-rsp-health"]]
    },
    {
        "id": "http-rsp-health",
        "type": "function",
        "z": "tab-evac",
        "name": "Respond Health",
        "func": "var nodeStatus = global.get('nodeStatus') || {};\nmsg.payload = nodeStatus;\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Access-Control-Allow-Origin': '*'\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 300,
        "y": 360,
        "wires": [["http-rsp-out2"]]
    },
    {
        "id": "http-rsp-out2",
        "type": "http response",
        "z": "tab-evac",
        "name": "HTTP Response",
        "statusCode": "200",
        "headers": {},
        "x": 480,
        "y": 360,
        "wires": [[]]
    },
    {
        "id": "mqtt-broker",
        "type": "mqtt-broker",
        "name": "Mosquitto",
